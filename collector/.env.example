# Copie para .env (modo 600, nunca commitado) e preencha.

# Backend que recebe as amostras (Cloudflare Worker).
UFCIM_SERVER_URL=https://ufcim-production.abner-hey.workers.dev
# Gerado por: node scripts/register-sensor.mjs --collector <nome> ... --write-env <este .env>
UFCIM_COLLECTOR_TOKEN=

# Aparelho (um por coletor neste modo).
UFCIM_DEVICE_ID=ebdaebfb3e5ed2f01crg1m
UFCIM_DEVICE_IP=192.168.50.33
UFCIM_DEVICE_PROTOCOL=3.5
UFCIM_DEVICE_PROFILE=breathe-btl40001
# Tuya Developer Platform > projeto > API Explorer > Query Device Details > local_key.
# Muda se o aparelho for resetado ou trocar de conta.
UFCIM_DEVICE_LOCAL_KEY=

# Opcionais
# UFCIM_POLL_SECONDS=15
# UFCIM_SEND_SECONDS=60
# UFCIM_OUTBOX_MAX_AGE_DAYS=7
